# ==========================================
# ChurnShield — Environment Configuration
# ==========================================

# 1. Persistent Database Connection (REQUIRED in production)
# PostgreSQL connection string (e.g. Neon). Production fails fast on startup
# if this is missing. Local development only falls back to data/store.json.
DATABASE_URL=

# 2. Whop Developer Platform Credentials
# From the Whop Developer Dashboard (whop.com/dashboard/developer).
# WHOP_WEBHOOK_SECRET is required: inbound webhooks are rejected without it.
WHOP_WEBHOOK_SECRET=
WHOP_APP_ID=
WHOP_COMPANY_ID=
# WHOP_API_KEY is accepted for parity with Elite's other apps but is NOT used
# by the ChurnShield MVP — v1 is webhook-in / dashboard-out and makes no Whop
# API calls. Leave it empty until a later version needs it.
WHOP_API_KEY=

# 3. Optional AI enhancement for playbook drafts
# Playbook drafts are generated from built-in templates and work with NO key.
# If GEMINI_API_KEY is set, drafts may be polished by Gemini; the API response
# always says which source produced a draft ("template" or "gemini") — a
# template draft is never presented as AI-written.
GEMINI_API_KEY=

# 4. Public Application URL (e.g. https://churnshield.onrender.com)
APP_URL=

# 5. Server Runtime Configuration
NODE_ENV=development
PORT=3000
# Days without any membership/payment webhook event before an active member
# is flagged "silent" (per-creator setting in the dashboard overrides this).
SILENT_MEMBER_DAYS=14
